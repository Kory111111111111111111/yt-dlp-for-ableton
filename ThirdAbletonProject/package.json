{
  "type": "module",
  "main": "dist/extension.js",
  "scripts": {
    "sync-sdk": "node scripts/sync-sdk.mjs",
    "preinstall": "node scripts/sync-sdk.mjs",
    "build": "tsc --noEmit && tsx build.ts",
    "start": "tsx build.ts && extensions-cli run --temp-directory .temp --storage-directory .storage",
    "test": "tsx --test tests/**/*.test.ts",
    "ci": "npm run build && npm run test",
    "verify": "npm run build && npm run test && tsx scripts/verify-tooling.ts",
    "package": "npm run build -- --production && extensions-cli package -o dist/YouTubeToProject.ablx"
  },
  "dependencies": {
    "@ableton-extensions/sdk": "file:./vendor/ableton-extensions-sdk-1.0.0-beta.0.tgz"
  },
  "devDependencies": {
    "@ableton-extensions/cli": "file:./vendor/ableton-extensions-cli-1.0.0-beta.0.tgz",
    "@types/node": "^25.9.1",
    "esbuild": "0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
